# Servidor
PORT=4000

# Base de datos (MaríaDB / MySQL)
DATABASE_URL="mysql://root:prueba@localhost:3306/mantenimiento"

# Variables usadas por la app (equivalen a DATABASE_URL descompuesta)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=prueba
DB_NAME=mantenimiento

# Autenticación JWT (obligatorio)
JWT_SECRET=cambiar_por_un_secreto_largo
JWT_EXPIRES=2h